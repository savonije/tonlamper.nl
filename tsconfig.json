{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"paths": {
			"@assets/*": ["./src/assets/*"],
			"@components/*": ["./src/components/*"],
			"@data/*": ["./src/data/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@styles/*": ["./src/style/*"],
			"@utils/*": ["./src/utils/*"]
		},
		"jsx": "preserve",
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			}
		]
	}
}
