---
interface Props {
	title: string
	datum: string
	lessen: string
	tijd: string
	periode: string
	locatie: string
	href: string
	extraInfo?: string
	hrefText: string
}

const {
	title,
	datum,
	lessen,
	tijd,
	periode,
	locatie,
	href,
	hrefText,
	extraInfo
} = Astro.props

const rows = [
	{ label: 'Datum', value: datum },
	{ label: 'Aantal lessen', value: lessen },
	{ label: 'Tijd', value: tijd },
	{ label: 'Periode', value: periode },
	{ label: 'Locatie', value: locatie }
].filter((r) => r.value)
---

<div class="border-line bg-paper flex h-full flex-col border p-7">
	<h2 class="mb-4 text-3xl">{title}</h2>

	{extraInfo && <p class="text-ink-2 mb-6 leading-relaxed">{extraInfo}</p>}

	<dl class="mb-8">
		{
			rows.map((row) => (
				<div class="flex gap-5 border-t py-3">
					<dt class="mono-label w-28 flex-none pt-1">{row.label}</dt>
					<dd class="text-ink leading-relaxed">{row.value}</dd>
				</div>
			))
		}
	</dl>

	<a class="btn mt-auto self-start no-underline!" href={href} target="_blank">
		{hrefText}
	</a>
</div>
