---
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/de-kunstenaar', label: 'Kunstenaar' },
	{ href: '/biografie', label: 'Biografie' },
	{ href: '/cursussen', label: 'Cursussen' },
	{ href: '/exposities', label: 'Exposities' },
	{ href: '/in-de-media', label: 'In de media' },
	{ href: '/contact', label: 'Contact' }
]

const path = Astro.url.pathname
const isActive = (href: string) =>
	href === '/' ? path === '/' : path === href || path.startsWith(href + '/')
---

<div class="lg:hidden">
	<button
		type="button"
		data-menu-open
		class="text-ink text-3xl"
		aria-label="Open menu"
		aria-expanded="false"
	>
		☰
	</button>
</div>

<nav data-menu class="main-menu closed" aria-label="Hoofdmenu">
	{
		links.map((link, i) => (
			<a
				href={link.href}
				class:list={[{ 'is-active': isActive(link.href) }]}
				aria-current={isActive(link.href) ? 'page' : undefined}
			>
				<span class="menu-no" aria-hidden="true">
					{String(i + 1).padStart(2, '0')}
				</span>
				<span class="menu-label">{link.label}</span>
			</a>
		))
	}

	<button
		type="button"
		data-menu-close
		class="text-ink absolute top-5 right-5 text-3xl lg:hidden"
		aria-label="Sluit menu"
	>
		&times;
	</button>
</nav>

<script>
	const closeMenu = () => {
		const nav = document.querySelector('[data-menu]')
		const openBtn = document.querySelector('[data-menu-open]')
		nav?.classList.add('closed')
		nav?.classList.remove('open')
		openBtn?.classList.remove('hidden')
		openBtn?.setAttribute('aria-expanded', 'false')
	}

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeMenu()
	})

	document.addEventListener('click', (e) => {
		const nav = document.querySelector('[data-menu]')
		const openBtn = document.querySelector('[data-menu-open]')
		const target = e.target as Node
		if (nav && openBtn && !nav.contains(target) && !openBtn.contains(target)) {
			closeMenu()
		}
	})

	const bindMenu = () => {
		const nav = document.querySelector('[data-menu]')
		const openBtn = document.querySelector<HTMLElement>('[data-menu-open]')
		if (!nav || !openBtn) return

		openBtn.addEventListener('click', () => {
			nav.classList.add('open')
			nav.classList.remove('closed')
			openBtn.classList.add('hidden')
			openBtn.setAttribute('aria-expanded', 'true')
		})
		nav.querySelector('[data-menu-close]')?.addEventListener('click', closeMenu)
		nav
			.querySelectorAll('a')
			.forEach((a) => a.addEventListener('click', closeMenu))
	}
	document.addEventListener('astro:page-load', bindMenu)
</script>

<style>
	@reference '@styles/base.css';

	.main-menu {
		@apply bg-paper fixed top-0 right-0 z-50 flex h-full w-[90%] translate-x-full flex-col justify-center gap-0 p-10 shadow-lg transition-transform md:bg-transparent lg:relative lg:h-auto lg:w-auto lg:translate-x-0 lg:flex-row lg:items-baseline lg:justify-end lg:gap-8 lg:p-0 lg:shadow-none;

		&.open {
			@apply translate-x-0;
		}

		a {
			font-family: var(--font-mono);
			@apply text-ink-2 relative flex items-baseline gap-4 border-b py-3.5 no-underline transition-colors lg:border-0 lg:py-0 lg:pb-1;

			&:hover {
				@apply text-ink;
			}

			&::after {
				content: '';
				@apply bg-accent absolute right-0 bottom-0 left-0 hidden h-[1.5px] origin-left scale-x-0 transition-transform duration-300 lg:block;
			}

			&:hover::after,
			&.is-active::after {
				@apply scale-x-100;
			}

			&.is-active {
				@apply text-ink;
			}
		}

		.menu-no {
			@apply text-2xs text-accent tracking-label lg:hidden;
		}

		.menu-label {
			font-family: var(--font-display);
			@apply text-ink text-3xl font-medium;
		}

		a.is-active .menu-label {
			@apply italic;
		}

		@media (min-width: 1024px) {
			.menu-label {
				font-family: var(--font-mono);
				@apply text-ink-2 text-xs font-normal tracking-[0.1em];
			}

			a:hover .menu-label,
			a.is-active .menu-label {
				@apply text-ink not-italic;
			}
		}
	}
</style>
