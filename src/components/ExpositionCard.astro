---
// ExpositionCard.astro

export interface Props {
	imageSrc?: string
	imageAlt?: string
	imageWidth?: number
	imageHeight?: number
	title: string
	locationLabel?: string
	location: string
	dateLabel?: string
	date: string
	description?: string
	linkUrl: string
	linkText?: string
	index?: number
}

const {
	imageSrc,
	imageAlt,
	imageWidth = 600,
	imageHeight = 800,
	title,
	locationLabel = 'Locatie',
	location,
	dateLabel = 'Datum',
	date,
	description,
	linkUrl,
	linkText = 'Meer informatie',
	index = 0
} = Astro.props

const isReversed = index % 2 === 1
---

<article
	class="border-t border-neutral-200 py-16 first:border-t-0 first:pt-4 lg:py-24 lg:first:pt-8"
>
	{
		imageSrc ? (
			<div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-20">
				<div class={`lg:col-span-7 ${isReversed ? 'lg:order-2' : ''}`}>
					<img
						src={imageSrc}
						width={imageWidth}
						height={imageHeight}
						alt={imageAlt || title}
						class="h-auto w-full"
					/>
				</div>

				<div class={`lg:col-span-5 ${isReversed ? 'lg:order-1' : ''}`}>
					<p class="text-2xs tracking-label-wide mb-5 text-neutral-500 uppercase">
						Tentoonstelling
					</p>
					<h2 class="lg:text-display! mb-10! text-2xl! leading-tight!">
						{title}
					</h2>

					<dl class="mb-10 space-y-6">
						<div class="border-t border-neutral-200 pt-4">
							<dt class="text-3xs tracking-label mb-2 text-neutral-500 uppercase">
								{dateLabel}
							</dt>
							<dd class="leading-relaxed text-neutral-800">{date}</dd>
						</div>
						<div class="border-t border-neutral-200 pt-4">
							<dt class="text-3xs tracking-label mb-2 text-neutral-500 uppercase">
								{locationLabel}
							</dt>
							<dd class="leading-relaxed text-neutral-800">{location}</dd>
						</div>
						{description && (
							<div class="border-t border-neutral-200 pt-4">
								<dd class="leading-relaxed text-neutral-700">{description}</dd>
							</div>
						)}
					</dl>

					<a
						href={linkUrl}
						target="_blank"
						class="text-2xs tracking-label inline-flex items-center gap-3 border-b border-black pb-1 uppercase no-underline! transition-all duration-300 hover:gap-5"
					>
						<span>{linkText}</span>
						<span aria-hidden="true">&rarr;</span>
					</a>
				</div>
			</div>
		) : (
			<div class="mx-auto max-w-xl text-center">
				<p class="text-2xs tracking-label-wide mb-5 text-neutral-500 uppercase">
					Tentoonstelling
				</p>
				<h2 class="lg:text-display! mb-10! text-2xl! leading-tight!">
					{title}
				</h2>

				<div class="mx-auto mb-10 max-w-md space-y-6">
					<div class="border-t border-neutral-200 pt-4">
						<dt class="text-3xs tracking-label mb-2 text-neutral-500 uppercase">
							{dateLabel}
						</dt>
						<dd class="leading-relaxed text-neutral-800">{date}</dd>
					</div>
					<div class="border-t border-neutral-200 pt-4">
						<dt class="text-3xs tracking-label mb-2 text-neutral-500 uppercase">
							{locationLabel}
						</dt>
						<dd class="leading-relaxed text-neutral-800">{location}</dd>
					</div>
					{description && (
						<div class="border-t border-neutral-200 pt-4">
							<dd class="leading-relaxed text-neutral-700">{description}</dd>
						</div>
					)}
				</div>

				<a
					href={linkUrl}
					target="_blank"
					class="text-2xs tracking-label inline-flex items-center gap-3 border-b border-black pb-1 uppercase no-underline! transition-all duration-300 hover:gap-5"
				>
					<span>{linkText}</span>
					<span aria-hidden="true">&rarr;</span>
				</a>
			</div>
		)
	}
</article>
