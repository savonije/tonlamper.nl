---
import Layout from '@layouts/Layout.astro'
import { Image } from 'astro:assets'
import flora from '@assets/flora-600x640.jpg'
---

<Layout title="Ton Lamper - Contact">
	<div class="container-narrow">
		<div class="flex flex-col gap-12 sm:flex-row">
			<div class="hidden w-1/2 flex-col items-center justify-center sm:flex">
				<Image
					src={flora}
					width={400}
					height={400}
					densities={[1, 2]}
					quality={72}
					alt=""
				/>
			</div>
			<div class="w-1/2">
				<h1>Contact</h1>
				<p>
					Stelt u mij een vraag en ik zal u zo spoedig mogelijk te woord staan.
				</p>

				<p>
					<strong>Ton Lamper</strong><br />
					Vermetstraat 31<br />
					4458 BA ’s Heer Arendskerke
				</p>

				Tel: <a href="tel:0113561841">0113-561841</a><br />
				Mobiel: <a href="tel:0610521843">06-10521843</a><br />
				Email: <a href="mailto:tonlamper@zeelandnet.nl"
					>tonlamper@zeelandnet.nl</a
				>
			</div>
		</div>
	</div>
</Layout>

<style>
	@reference "tailwindcss";
	p {
		margin-bottom: 1em;
	}

	a {
		color: black;
	}
</style>
