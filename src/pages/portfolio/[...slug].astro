---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import { getPortfolioImage } from '@utils/portfolioImages'

export async function getStaticPaths() {
	const artworks = await getCollection('artworks')

	return artworks.map(({ data: { slug, name, images, text } }) => {
		return {
			params: { slug },
			props: { name, images, text }
		}
	})
}

const { name, images, text } = Astro.props
const title = `Ton Lamper - ${name}`
---

<Layout title={title}>
	<div class="mb-6 text-sm">
		/
		<a href="/portfolio" class="inline-flex items-center no-underline!"
			>Portfolio</a
		>
		// {name}
	</div>

	<div class="mb-9 text-center">
		<h1 class="mb-0">{name}</h1>
	</div>

	<div class="container-narrow">
		{text && <div class="mb-9" set:html={text} />}
	</div>

	<div class="flex flex-wrap justify-center gap-6">
		{
			images.map((image) => {
				const img = getPortfolioImage(image)
				return (
					<Image
						src={img}
						alt={name}
						height={Math.min(img.height, 1200)}
						quality={72}
						format="webp"
						layout="none"
						class="h-auto max-h-[800px] w-auto"
					/>
				)
			})
		}
	</div>
</Layout>
