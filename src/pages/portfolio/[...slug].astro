---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import { getPortfolioImage } from '@utils/portfolioImages'

export async function getStaticPaths() {
	const artworks = await getCollection('artworks')

	return artworks.map(({ data: { slug, name, images, text } }) => {
		return {
			params: { slug },
			props: { name, images, text }
		}
	})
}

const { name, images, text } = Astro.props
const { slug } = Astro.params
const title = `Ton Lamper - ${name}`
---

<Layout title={title}>
	<nav
		class="mono-label flex items-center gap-2 pt-8 pb-10"
		aria-label="Kruimelpad"
	>
		<a href="/portfolio" class="hover:text-accent no-underline!">Portfolio</a>
		<span aria-hidden="true">/</span>
		<span class="text-ink">{name}</span>
	</nav>

	<header class="border-t-ink mb-12 border-t pt-8 text-center" data-reveal>
		<p class="eyebrow mb-5 justify-center">Werk</p>
		<h1 class="mb-0 text-5xl sm:text-6xl">{name}</h1>
	</header>

	{
		text && (
			<div
				class="container-narrow prose-body mb-14 text-lg leading-relaxed text-pretty"
				data-reveal
				set:html={text}
			/>
		)
	}

	<div class="flex flex-wrap items-start justify-center gap-8">
		{
			images.map((image, i) => {
				const img = getPortfolioImage(image)
				return (
					<figure
						class="border-line-2 bg-paper/40 border p-2"
						data-reveal
						style={`transition-delay: ${i * 70}ms`}
					>
						<Image
							src={img}
							alt={name}
							height={Math.min(img.height, 1200)}
							quality={72}
							format="webp"
							layout="none"
							class="block h-auto max-h-[800px] w-auto"
							transition:name={i === 0 ? `art-${slug}` : undefined}
						/>
					</figure>
				)
			})
		}
	</div>

	<p class="container-narrow text-ink/60 mt-16 text-center text-sm" data-reveal>
		Al het werk is te koop. Voor meer informatie neem gerust{' '}
		<a href="/contact" class="hover:text-accent text-ink">contact</a> op.
	</p>

	<div class="mt-10 text-center" data-reveal>
		<a
			href="/portfolio"
			class="text-2xs tracking-label hover:text-accent hover:border-accent border-ink inline-flex items-center gap-3 border-b pb-1 font-mono uppercase no-underline! transition-all duration-300 hover:gap-5"
		>
			<span aria-hidden="true">&larr;</span>
			<span>Terug naar portfolio</span>
		</a>
	</div>
</Layout>

<style>
	@reference '@styles/base.css';
	.prose-body :global(p) {
		@apply mb-4;
	}
</style>
