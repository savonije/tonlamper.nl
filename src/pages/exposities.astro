---
import Layout from '@layouts/Layout.astro'
import ExpositionCard from '@components/ExpositionCard.astro'

const exposities = [
	{
		title: 'Grafiek in beeld – Ton Lamper en Burhan Saleh',
		location: 'Kunstuitleen de Bevelanden, Westwal 45, 4461CM Goes',
		date: 'za. 9 mei t/m vr. 10 juli — donderdag en vrijdag 14.00–17.00u. en zaterdag 10.00–13.00u.',
		linkUrl: 'http://www.kunstingoes.nl/opening-tentoonstelling/',
		linkText: 'Meer informatie',
		imageSrc: '/images/exposities/kunstuitleen-goes.webp'
	},
	{
		title: 'Kunstschouw 2026',
		location: 'Hervormde kerk, Burghsering 33, 4328 LK, Burgh-Haamstede',
		date: 'za. 13 juni t/m zo. 21 juni — 10.00–17.00u.',
		linkUrl: 'https://kunstschouw.nl/',
		linkText: 'Meer informatie'
	}
]
---

<Layout title="Ton Lamper - Exposities">
	<section class="container-narrow pt-10 pb-6 text-center lg:pt-16">
		<p class="mb-6 text-[11px] tracking-[0.4em] text-neutral-500 uppercase">
			Aankomend &amp; doorlopend
		</p>
		<h1 class="mb-8!">Exposities</h1>
		<div
			class="mx-auto mb-10 h-px w-12 bg-neutral-300"
			aria-hidden="true"
		/>
		<p class="mx-auto max-w-md leading-relaxed text-neutral-600">
			Een selectie van tentoonstellingen waar werk van Ton Lamper te zien is.
		</p>
	</section>

	<div class="mx-auto max-w-5xl">
		{exposities.map((expo, i) => <ExpositionCard {...expo} index={i} />)}
	</div>
</Layout>
