---
import Layout from '@layouts/Layout.astro'
import ExpositionCard from '@components/ExpositionCard.astro'
import { getCollection } from 'astro:content'
import { getAssetImage } from '@utils/assetImages'

// Sort by numeric id to preserve the original expositions.json array order.
const exposities = (await getCollection('expositions')).sort(
	(a, b) => Number(a.id) - Number(b.id)
)

const items = exposities.map(({ data: { imageSrc, ...rest } }) => ({
	...rest,
	image: imageSrc ? getAssetImage(imageSrc) : undefined
}))
---

<Layout title="Ton Lamper - Exposities">
	<section class="pt-10 pb-12 lg:pt-16">
		<p class="eyebrow mb-6">Aankomend &amp; doorlopend</p>
		<h1 class="mb-8 text-6xl sm:text-7xl">Exposities</h1>
		<p class="text-ink-2 max-w-md text-xl leading-relaxed text-pretty">
			Een selectie van tentoonstellingen waar werk van Ton Lamper te zien is.
		</p>
	</section>

	<div class="border-t-ink mx-auto max-w-5xl border-t">
		{
			items.length > 0 ? (
				items.map((expo, i) => <ExpositionCard {...expo} index={i} />)
			) : (
				<p class="text-ink-2 px-6 py-16 text-center leading-relaxed lg:py-24">
					Op dit moment zijn er geen exposities...
				</p>
			)
		}
	</div>
</Layout>
