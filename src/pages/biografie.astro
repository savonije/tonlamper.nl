---
import Layout from '@layouts/Layout.astro'
import { getCollection } from 'astro:content'

// Sort by numeric id to preserve the original biografie.json array order
// (the grouping below depends on chronological order).
const entries = (await getCollection('biografie')).sort(
	(a, b) => Number(a.id) - Number(b.id)
)

type Group = { year: string; items: string[] }
const groups: Group[] = []
for (const { data: e } of entries) {
	const last = groups[groups.length - 1]
	if (e.year && (!last || last.year !== e.year)) {
		groups.push({ year: e.year, items: [e.text] })
	} else if (last) {
		last.items.push(e.text)
	} else {
		groups.push({ year: e.year, items: [e.text] })
	}
}

groups.reverse()
---

<Layout title="Ton Lamper - Biografie">
	<section class="pt-10 pb-12 lg:pt-16">
		<p class="eyebrow mb-6">Een leven in beelden</p>
		<h1 class="mb-8 text-6xl sm:text-7xl">Biografie</h1>
		<p class="text-ink-2 max-w-md text-xl leading-relaxed text-pretty">
			Een chronologisch overzicht van tentoonstellingen, projecten en mijlpalen.
		</p>
	</section>

	<div class="mx-auto max-w-4xl pb-16">
		{
			groups.map((g, i) => (
				<article
					class={`grid grid-cols-1 gap-3 py-8 sm:grid-cols-12 sm:gap-10 lg:py-10 ${i > 0 ? 'border-t' : 'border-t-ink border-t pt-10'}`}
					data-reveal
				>
					<div class="sm:col-span-3">
						<p class="font-display text-ink-3 text-4xl font-medium tabular-nums sm:text-5xl">
							{g.year}
						</p>
					</div>
					<div class="text-ink space-y-3 leading-relaxed sm:col-span-9">
						{g.items.map((text) => (
							<p class="text-pretty">{text}</p>
						))}
					</div>
				</article>
			))
		}
	</div>
</Layout>
