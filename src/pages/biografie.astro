---
import Layout from '@layouts/Layout.astro'
import { getCollection } from 'astro:content'

// Sort by numeric id to preserve the original biografie.json array order
// (the grouping below depends on chronological order).
const entries = (await getCollection('biografie')).sort(
	(a, b) => Number(a.id) - Number(b.id)
)

type Group = { year: string; items: string[] }
const groups: Group[] = []
for (const { data: e } of entries) {
	const last = groups[groups.length - 1]
	if (e.year && (!last || last.year !== e.year)) {
		groups.push({ year: e.year, items: [e.text] })
	} else if (last) {
		last.items.push(e.text)
	} else {
		groups.push({ year: e.year, items: [e.text] })
	}
}

groups.reverse()
---

<Layout title="Ton Lamper - Biografie">
	<section class="container-narrow pt-10 pb-6 text-center lg:pt-16">
		<p class="text-2xs tracking-label-wide mb-6 text-neutral-500 uppercase">
			Een leven in beelden
		</p>
		<h1 class="mb-8!">Biografie</h1>
		<div class="mx-auto mb-10 h-px w-12 bg-neutral-300" aria-hidden="true">
		</div>
		<p class="mx-auto max-w-md leading-relaxed text-neutral-600">
			Een chronologisch overzicht van tentoonstellingen, projecten en mijlpalen.
		</p>
	</section>

	<div class="mx-auto max-w-4xl pb-16">
		{
			groups.map((g, i) => (
				<article
					class={`grid grid-cols-1 gap-3 py-8 sm:grid-cols-12 sm:gap-10 lg:py-10 ${i > 0 ? 'border-t border-neutral-200' : 'pt-4'}`}
				>
					<div class="sm:col-span-3">
						<p class="text-2xl font-light tracking-wide text-neutral-400 tabular-nums sm:text-3xl">
							{g.year}
						</p>
					</div>
					<div class="space-y-3 leading-relaxed text-neutral-800 sm:col-span-9">
						{g.items.map((text) => (
							<p>{text}</p>
						))}
					</div>
				</article>
			))
		}
	</div>
</Layout>
