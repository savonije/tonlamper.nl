---
import { getImage } from 'astro:assets'
import Layout from '@layouts/Layout.astro'
import Artwork from '@components/Portfolio.vue'
import artworks from '@data/artworks.json'
import { getPortfolioImage } from '@utils/portfolioImages'

// Vue islands can't use Astro's <Image>, so pre-generate optimized webp
// thumbnails here and hand the Vue grid a { slug: { src, width, height } }
// map. The dimensions let the grid reserve correct space and avoid layout
// shift while images load.
const entries = await Promise.all(
	Object.values(artworks).map(async (artwork) => {
		const src = getPortfolioImage(artwork.images[0])
		const width = Math.min(src.width, 500)
		const height = Math.round((src.height / src.width) * width)
		const thumb = await getImage({ src, width, quality: 72, format: 'webp' })
		return [artwork.slug, { src: thumb.src, width, height }]
	})
)
const thumbnails = Object.fromEntries(entries)
---

<Layout title="Ton Lamper - Portfolio">
	<Artwork client:idle thumbnails={thumbnails} />
</Layout>
