---
import { getImage } from 'astro:assets'
import { getCollection, type CollectionEntry } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import { getPortfolioImage } from '@utils/portfolioImages'
import { categories } from '@utils/constants'

// Newest-first, matching the portfolio grid ordering.
const artworks = (await getCollection('artworks')).sort(
	(a, b) => Number(b.id) - Number(a.id)
)

// Build a display card (responsive webp thumbnail) from an artwork entry.
// Featured cards render larger, so they get a wider source.
const toCard = async (entry: CollectionEntry<'artworks'>, maxWidth: number) => {
	const { slug, name, category, images } = entry.data
	const src = getPortfolioImage(images[0])
	const width = Math.min(src.width, maxWidth)
	const height = Math.round((src.height / src.width) * width)
	const thumb = await getImage({ src, width, quality: 72, format: 'webp' })
	return { slug, name, category, thumb: { src: thumb.src, width, height } }
}

const featured = await Promise.all(
	artworks.filter(({ data }) => data.featured).map((a) => toCard(a, 900))
)

const works = await Promise.all(
	artworks
		.filter(({ data }) => data.category !== null)
		.map((a) => toCard(a, 600))
)
---

<Layout title="Ton Lamper">
	<!-- ── Statement hero ───────────────────────────── -->
	<section
		class="flex min-h-[64vh] flex-col items-center justify-center py-[clamp(48px,9vw,120px)] text-center"
	>
		<p class="eyebrow mb-8">Grafisch kunstenaar — Nederland</p>
		<h1
			class="font-display mb-10 text-[clamp(52px,13vw,132px)] leading-[0.94] font-medium tracking-[-0.02em]"
		>
			Ton Lamper
		</h1>
		<p
			class="text-ink-2 mx-auto max-w-[40ch] text-[clamp(19px,2vw,25px)] leading-relaxed text-pretty"
		>
			Een reservoir van beelden met groot contrast — figuratie, anatomie en
			kunsthistorie, gemonteerd als een filmische beeldenstroom.
		</p>
		<div class="mono-label mt-14" aria-hidden="true">werk &darr;</div>
	</section>

	<!-- ── Featured ─────────────────────────────────── -->
	{
		featured.length > 0 && (
			<section class="pt-[clamp(40px,6vw,80px)]">
				<div class="border-b-ink mb-[clamp(28px,4vw,44px)] flex items-baseline justify-between border-b pb-3.5">
					<p class="eyebrow">Uitgelicht</p>
					<span class="mono-label">{featured.length} werken</span>
				</div>

				<div class="grid grid-cols-1 gap-x-[clamp(28px,4vw,56px)] gap-y-[clamp(48px,6vw,84px)] md:grid-cols-2">
					{featured.map((w, i) => (
						<a
							href={`/portfolio/${w.slug}`}
							class="work group block no-underline"
							data-reveal
							style={`transition-delay: ${(i % 2) * 80}ms`}
						>
							<div class="work__plate border-line bg-paper overflow-hidden border transition-all duration-500 ease-out group-hover:-translate-y-1.5">
								<img
									src={w.thumb.src}
									alt={w.name}
									width={w.thumb.width}
									height={w.thumb.height}
									loading={i < 2 ? 'eager' : 'lazy'}
									class="block h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.055]"
								/>
							</div>
							<div class="mt-4">
								<h3 class="font-display group-hover:text-accent text-[clamp(28px,3vw,38px)] leading-[1.05] font-medium transition-colors">
									{w.name}
								</h3>
								{w.category && (
									<div class="mono-label mt-1.5">{w.category.join(' · ')}</div>
								)}
							</div>
						</a>
					))}
				</div>
			</section>
		)
	}

	<!-- ── Gallery grid ─────────────────────────────── -->
	<section class="pt-[clamp(40px,6vw,80px)] pb-4">
		<div
			class="border-b-ink mb-[clamp(28px,4vw,44px)] flex items-baseline justify-between border-b pb-3.5"
		>
			<p class="eyebrow">Werk</p>
			<span class="mono-label"
				><span data-count>{works.length}</span> werken</span
			>
		</div>

		<div
			class="mb-[clamp(32px,4vw,56px)] flex flex-wrap items-center gap-x-6 gap-y-3"
			data-filter
			role="group"
			aria-label="Filter op techniek"
		>
			<button
				type="button"
				class="filter-btn is-active"
				data-filter-btn
				data-cat=""
				aria-pressed="true">Alles</button
			>
			{
				categories.map((cat) => (
					<button
						type="button"
						class="filter-btn"
						data-filter-btn
						data-cat={cat}
						aria-pressed="false"
					>
						{cat}
					</button>
				))
			}
		</div>

		<div
			class="grid grid-cols-1 gap-x-[clamp(28px,4vw,56px)] gap-y-[clamp(48px,6vw,84px)] sm:grid-cols-2 lg:grid-cols-3"
		>
			{
				works.map((w, i) => (
					<a
						href={`/portfolio/${w.slug}`}
						class="work group block no-underline"
						data-reveal
						data-cats={(w.category ?? []).join(' ')}
						style={`transition-delay: ${(i % 3) * 80}ms`}
					>
						<div class="work__plate border-line bg-paper overflow-hidden border transition-all duration-500 ease-out group-hover:-translate-y-1.5">
							<img
								src={w.thumb.src}
								alt={w.name}
								width={w.thumb.width}
								height={w.thumb.height}
								loading={i < 6 ? 'eager' : 'lazy'}
								class="block h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.055]"
							/>
						</div>
						<div class="mt-4">
							<h3 class="font-display group-hover:text-accent text-[26px] leading-[1.05] font-medium transition-colors">
								{w.name}
							</h3>
							{w.category && (
								<div class="mono-label mt-1.5">{w.category.join(' · ')}</div>
							)}
						</div>
					</a>
				))
			}
		</div>
	</section>
</Layout>

<script>
	// Client-side filtering of the (already server-rendered) gallery by
	// technique. Pure show/hide — no data fetching — so it stays a small
	// vanilla script, matching the navigation menu. Re-binds after every
	// ClientRouter page swap.
	const initFilter = () => {
		const bar = document.querySelector('[data-filter]')
		if (!bar) return

		const buttons = [
			...bar.querySelectorAll<HTMLButtonElement>('[data-filter-btn]')
		]
		const works = [...document.querySelectorAll<HTMLElement>('[data-cats]')]
		const countEl = document.querySelector('[data-count]')

		const apply = (cat: string) => {
			let visible = 0
			for (const work of works) {
				const cats = (work.dataset.cats ?? '').split(' ')
				const show = !cat || cats.includes(cat)
				work.classList.toggle('hidden', !show)
				if (show) {
					// Guarantee filtered-in works aren't stuck at the reveal
					// animation's initial opacity:0 if they were never scrolled to.
					work.classList.add('is-rev')
					visible++
				}
			}
			if (countEl) countEl.textContent = String(visible)
			for (const btn of buttons) {
				const active = (btn.dataset.cat ?? '') === cat
				btn.classList.toggle('is-active', active)
				btn.setAttribute('aria-pressed', active ? 'true' : 'false')
			}
		}

		for (const btn of buttons) {
			btn.addEventListener('click', () => apply(btn.dataset.cat ?? ''))
		}
	}
	document.addEventListener('astro:page-load', initFilter)
</script>

<style>
	@reference '@styles/base.css';
	.work:hover .work__plate {
		box-shadow: 0 18px 40px -22px rgb(0 0 0 / 0.5);
	}
</style>
