---
import Header from '../components/Header.astro'
import { ClientRouter } from 'astro:transitions'
import '@styles/base.css'
interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Ton Lamper is kunstenaar en docent. Zijn grafisch werk is een combinatie van diverse technieken zoals: de lijnets, kleurenets, kartondruk, linoleumsnede en houtsnede."
		/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="flex h-full flex-col">
		<Header />
		<main class="container grow">
			<slot />
		</main>
		<footer class="border-t-ink mt-20 border-t">
			<div class="container py-10">
				<div class="flex flex-wrap items-start justify-between gap-7">
					<div>
						<div class="font-display text-3xl font-medium">Ton Lamper</div>
						<div class="mono-label mt-1.5">Grafisch kunstenaar</div>
					</div>
					<a
						href="https://www.instagram.com/tonlamper"
						target="_blank"
						class="mono-label hover:text-accent pt-2 no-underline"
					>
						Instagram &rarr;
					</a>
				</div>
				<div
					class="mono-label mt-10 flex flex-wrap justify-between gap-3 border-t pt-5"
				>
					<span>
						&copy; {new Date().getFullYear()} Ton Lamper. All rights reserved.
					</span>
					<span>Ets &middot; kartondruk &middot; houtsnede</span>
				</div>
			</div>
		</footer>

		<script>
			// Scroll-reveal: elements with [data-reveal] rise in when they enter
			// the viewport. Re-runs after every ClientRouter page swap.
			const initReveals = () => {
				const els = document.querySelectorAll('[data-reveal]:not(.is-rev)')
				if (!els.length) return
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					els.forEach((el) => el.classList.add('is-rev'))
					return
				}
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-rev')
								io.unobserve(entry.target)
							}
						}
					},
					{ threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
				)
				els.forEach((el) => io.observe(el))
			}
			document.addEventListener('astro:page-load', initReveals)
		</script>
	</body>
</html>
